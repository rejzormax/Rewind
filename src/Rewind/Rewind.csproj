<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Rewind.props"/>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../../assets/rewind.ico')">../../assets/rewind.ico</ApplicationIcon>
    <AssemblyName>Rewind</AssemblyName>
    <Authors>Rewind</Authors>
    <Description>A native, GPU-first replay recorder.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Rewind.Core/Rewind.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Resources/clip-ding.wav" LogicalName="Rewind.ClipDing" /></ItemGroup>
</Project>
