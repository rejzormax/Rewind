<Window x:Class="Rewind.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rewind"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Rewind" Width="1440" Height="900" MinWidth="1020" MinHeight="670" WindowStartupLocation="CenterScreen"
    Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="CanResize"
    Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <local:ThumbnailConverter x:Key="Thumbnail"/>
    <Geometry x:Key="FolderGeometry">M2 7 Q2 4 5 4 H10 L13 7 H21 Q24 7 24 10 V20 Q24 23 21 23 H5 Q2 23 2 20 Z</Geometry>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="ClipRowContainer" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="ClipTile">
      <Border Background="#171719" CornerRadius="8" Margin="0,0,16,0">
        <StackPanel>
          <local:VideoPreviewFrame>
            <Button Tag="{Binding Path}" Click="OpenClip" Padding="0" BorderThickness="0" Background="#242429" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Play saved clip">
              <Grid>
                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#73737B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumbnail}}" Stretch="UniformToFill"/>
                <Border Background="#E6101012" CornerRadius="5" Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                  <TextBlock Text="{Binding DurationLabel}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                </Border>
              </Grid>
            </Button>
          </local:VideoPreviewFrame>
          <StackPanel Margin="14,12,14,13">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#AEAEB5" Margin="0,1,6,0"/>
              <TextBlock Text="{Binding LibraryDetailLabel}" FontSize="11" Foreground="#AEAEB5" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
          <Border Background="#222225" CornerRadius="0,0,8,8" Padding="7,5">
            <Grid>
              <Button Tag="{Binding Path}" Click="OpenClip" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Padding="8,8">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,7,0"/><TextBlock Text="Play clip" FontSize="12" FontWeight="SemiBold"/></StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Tag="{Binding Path}" Click="CopyClipPath" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Padding="8,8" ToolTip="Copy file path" AutomationProperties.Name="Copy clip file path"/>
                <Button Tag="{Binding Path}" Click="RevealClip" Style="{StaticResource ToolbarButton}" Padding="8,8" ToolTip="Show in folder" AutomationProperties.Name="Show clip in folder"><Viewbox Width="14" Height="14"><Path Data="{StaticResource FolderGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox></Button>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ClipRowTemplate">
      <ItemsControl ItemsSource="{Binding Clips}" ItemTemplate="{StaticResource ClipTile}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>
  </Window.Resources>
  <Border Background="{StaticResource Canvas}" BorderBrush="#29292C" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Rail}" MouseLeftButtonDown="DragTitleBar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="62"/><ColumnDefinition Width="68"/><ColumnDefinition Width="155"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Viewbox Width="32" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Rewind">
          <Path Data="{StaticResource RewindLogoGeometry}" Fill="White"/>
        </Viewbox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Click="GoBack" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Padding="7,8" ToolTip="Back" AutomationProperties.Name="Go back"/>
          <Button x:Name="ForwardButton" Click="GoForward" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Padding="7,8" ToolTip="Forward" AutomationProperties.Name="Go forward"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
          <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="#93939B" VerticalAlignment="Center" Margin="0,0,9,0"/>
          <TextBlock x:Name="HeaderStatus" Text="Capture ready" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,15,0">
          <Border Background="#29292D" CornerRadius="4" Padding="8,6"><TextBlock x:Name="HeaderHotkeyText" Text="Ctrl+Shift+F9" FontSize="11" FontWeight="SemiBold"/></Border>
          <Button Tag="Capture" Click="Navigate" Style="{StaticResource QuietButton}" Padding="9,6" ToolTip="Replay length">
            <TextBlock x:Name="HeaderClipLengthText" Text="Clip 30s" FontSize="12" Foreground="{StaticResource Muted}"/>
          </Button>
        </StackPanel>
        <Button Grid.Column="4" Tag="Capture" Click="Navigate" Style="{StaticResource QuietButton}" Padding="0,6" Margin="0,0,17,0" ToolTip="Replay buffer status">
          <StackPanel Orientation="Horizontal"><Border Background="#29292D" CornerRadius="4" Padding="7,5"><TextBlock x:Name="HeaderBufferBadge" Text="OFF" FontSize="10" FontWeight="Bold"/></Border><TextBlock Text="Replay buffer" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/></StackPanel>
        </Button>
        <Button Grid.Column="5" Tag="Capture" Click="Navigate" Style="{StaticResource QuietButton}" Padding="0,6" ToolTip="Capture profile">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBlock x:Name="HeaderProfileText" Text="1080p 60 FPS" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
          <Button x:Name="ArmButton" Content="Start buffer" Click="ToggleCapture" Style="{StaticResource PrimaryButton}" Padding="11,7" FontSize="11" Margin="0,0,7,0"/>
          <Button x:Name="SaveClipButton" Content="Save clip" Click="SaveClip" Padding="11,7" FontSize="11" Margin="0,0,10,0" IsEnabled="False"/>
          <Button Style="{StaticResource QuietButton}" Width="32" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="MinimizeWindow" ToolTip="Minimize" AutomationProperties.Name="Minimize Rewind"/>
          <Button Style="{StaticResource QuietButton}" Width="32" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="MaximizeWindow" ToolTip="Maximize" AutomationProperties.Name="Maximize Rewind"/>
          <Button Style="{StaticResource QuietButton}" Width="32" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="CloseWindow" ToolTip="Close to tray" AutomationProperties.Name="Close Rewind window"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource Rail}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="NavDashboard" Tag="Dashboard" Click="Navigate" Style="{StaticResource NavButton}" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20" ToolTip="Recorder" AutomationProperties.Name="Recorder"/>
            <Button x:Name="NavLibrary" Tag="Library" Click="Navigate" Style="{StaticResource NavButton}" ToolTip="Clip library" AutomationProperties.Name="Clip library">
              <Viewbox Width="21" Height="21"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M2 10 H22 V21 Q22 24 19 24 H5 Q2 24 2 21 Z M1 5 L21 0 22 5 2 10 Z M6 4 L9 3 12 7 9 8 Z M14 2 L17 1 20 5 17 6 Z"/></Viewbox>
            </Button>
            <Button Click="OpenClipsFolder" Style="{StaticResource NavButton}" ToolTip="Open clips folder" AutomationProperties.Name="Open clips folder"><Viewbox Width="21" Height="21"><Path Data="{StaticResource FolderGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox></Button>
            <Button x:Name="NavDiscord" Tag="Discord" Click="Navigate" Style="{StaticResource NavButton}" Content="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="21" ToolTip="Discord presence" AutomationProperties.Name="Discord presence"/>
          </StackPanel>
          <Button x:Name="NavCapture" Grid.Row="1" Tag="Capture" Click="Navigate" Style="{StaticResource NavButton}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22" Margin="0,0,0,12" ToolTip="Capture settings" AutomationProperties.Name="Capture settings"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="LibraryToolbar" Height="66" Background="{StaticResource Toolbar}" CornerRadius="10,0,0,0">
          <Grid Margin="18,0,21,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ImportButton" Click="ImportClips" Style="{StaticResource ToolbarButton}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Import" FontWeight="SemiBold"/></StackPanel>
            </Button>
            <Button Grid.Column="1" Click="OpenClipsFolder" Style="{StaticResource ToolbarButton}" VerticalAlignment="Center" Margin="6,0,11,0">
              <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,8,0"><Path Data="{StaticResource FolderGeometry}" Fill="{StaticResource Ink}"/></Viewbox><TextBlock Text="Open folder" FontWeight="SemiBold"/></StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0"><Border Width="1" Height="32" Background="#414146" Margin="0,0,13,0"/><TextBlock Text="Filters" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
            <ComboBox x:Name="DateFilterBox" Grid.Column="3" Width="128" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="LibraryFilterChanged" SelectedIndex="0">
              <ComboBoxItem Content="All dates" Tag="all"/><ComboBoxItem Content="Today" Tag="today"/><ComboBoxItem Content="Last 7 days" Tag="week"/><ComboBoxItem Content="Last 30 days" Tag="month"/>
            </ComboBox>
            <ComboBox x:Name="SortBox" Grid.Column="4" Width="145" FontSize="12" VerticalAlignment="Center" SelectionChanged="LibraryFilterChanged" SelectedIndex="0">
              <ComboBoxItem Content="Newest first" Tag="newest"/><ComboBoxItem Content="Oldest first" Tag="oldest"/><ComboBoxItem Content="Largest first" Tag="size"/>
            </ComboBox>
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="212" Margin="15,0,7,0">
                <TextBox x:Name="SearchBox" FontSize="12" Padding="11,9" TextChanged="SearchClips" Background="#171719" ToolTip="Search clip names" AutomationProperties.Name="Search clips"/>
                <TextBlock Text="Search clips…" Foreground="#A0A0A8" Margin="12,0" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="RefreshClips" ToolTip="Refresh library" AutomationProperties.Name="Refresh library"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="22,17,7,13">
          <Grid x:Name="LibraryPage" SizeChanged="GallerySizeChanged">
            <ListBox x:Name="AllClips" ItemTemplate="{StaticResource ClipRowTemplate}" ItemContainerStyle="{StaticResource ClipRowContainer}"
                Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="0.5">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <StackPanel x:Name="LibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,60" MaxWidth="430">
              <Viewbox Width="58" Height="58" HorizontalAlignment="Center" Margin="0,0,0,21"><Path Fill="#5C5C65" Data="M2 10 H22 V21 Q22 24 19 24 H5 Q2 24 2 21 Z M1 5 L21 0 22 5 2 10 Z M6 4 L9 3 12 7 9 8 Z M14 2 L17 1 20 5 17 6 Z"/></Viewbox>
              <TextBlock x:Name="LibraryEmptyTitle" Text="Your clips will appear here" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock x:Name="LibraryEmptyDescription" Text="Start the replay buffer, then save a moment with your clip shortcut." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" TextAlignment="Center" Margin="0,10,0,24" LineHeight="21"/>
              <Button Content="Capture settings" Tag="Capture" Click="Navigate" HorizontalAlignment="Center" Background="#252529" BorderBrush="#44444A" Padding="17,10" FontSize="12"/>
            </StackPanel>
          </Grid>
          <ScrollViewer x:Name="DashboardPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="10,10,28,0">
              <TextBlock Text="Replay buffer" FontSize="27" FontWeight="SemiBold"/>
              <TextBlock Text="Keep the last few seconds ready to save." Style="{StaticResource MutedText}" Margin="0,8,0,27"/>
              <Border Style="{StaticResource Card}" Padding="26"><StackPanel>
                <Grid><TextBlock Text="BUFFER" Style="{StaticResource Caption}"/><TextBlock x:Name="BufferStateText" Text="Capture ready" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="12"/></Grid>
                <StackPanel Orientation="Horizontal" Margin="0,15,0,19"><TextBlock x:Name="BufferTimeText" Text="0s" FontSize="46" FontWeight="SemiBold"/><TextBlock x:Name="BufferLimitText" Text="/ 30 seconds" FontSize="14" Foreground="{StaticResource Muted}" Margin="11,0,0,9" VerticalAlignment="Bottom"/></StackPanel>
                <ProgressBar x:Name="BufferProgress" Height="7" Minimum="0" Maximum="30"/>
                <Grid Margin="0,22,0,0"><TextBlock Text="Replay length" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <StackPanel x:Name="DurationButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="15s" Tag="15" Click="QuickDuration" Padding="12,7" FontSize="12" Margin="0,0,7,0"/><Button Content="30s" Tag="30" Click="QuickDuration" Padding="12,7" FontSize="12" Margin="0,0,7,0"/><Button Content="60s" Tag="60" Click="QuickDuration" Padding="12,7" FontSize="12" Margin="0,0,7,0"/><Button Content="120s" Tag="120" Click="QuickDuration" Padding="12,7" FontSize="12"/>
                  </StackPanel>
                </Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="ProfileFpsText" Text="60 FPS" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProfileEncoderText" Text="Auto · GPU first" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/><TextBlock x:Name="ProfileBitrateText" Text="8 Mbps · Native resolution" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="Adjust capture" Tag="Capture" Click="Navigate" Style="{StaticResource QuietButton}" VerticalAlignment="Center"/>
              </Grid></Border>
              <TextBlock x:Name="ShortcutHint" Text="Save from anywhere with Ctrl + Shift + F9." Style="{StaticResource MutedText}" FontSize="12" Margin="1,20,0,0"/>
              <Button Content="View clip library" Tag="Library" Click="Navigate" HorizontalAlignment="Left" Margin="0,20,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="CapturePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,5,0">
            <TextBlock Text="Make it your replay." FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Name="CaptureSettingsHint" Text="Changes apply the next time you start the buffer." Style="{StaticResource MutedText}" Margin="0,7,0,22"/>
            <Border Style="{StaticResource Card}"><StackPanel x:Name="CaptureControls">
              <TextBlock Text="Video capture" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,19"/>
              <TextBlock Text="DISPLAY" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <ComboBox x:Name="DisplayBox" DisplayMemberPath="Label" SelectionChanged="CaptureSettingChanged" Margin="0,0,0,18"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="REPLAY LENGTH" Style="{StaticResource Caption}" Margin="0,0,0,8"/><ComboBox x:Name="BufferBox" SelectionChanged="CaptureSettingChanged"><ComboBoxItem Content="15 seconds" Tag="15"/><ComboBoxItem Content="30 seconds" Tag="30"/><ComboBoxItem Content="60 seconds" Tag="60"/><ComboBoxItem Content="120 seconds" Tag="120"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="FRAME RATE" Style="{StaticResource Caption}" Margin="0,0,0,8"/><ComboBox x:Name="FpsBox" SelectionChanged="CaptureSettingChanged"><ComboBoxItem Content="30 FPS · Efficient" Tag="30"/><ComboBoxItem Content="60 FPS · Smooth" Tag="60"/></ComboBox></StackPanel>
              </Grid>
              <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ENCODER" Style="{StaticResource Caption}" Margin="0,0,0,8"/><ComboBox x:Name="EncoderBox" SelectionChanged="CaptureSettingChanged"><ComboBoxItem Content="Auto · GPU first" Tag="Auto"/><ComboBoxItem Content="NVIDIA NVENC" Tag="NVIDIA"/><ComboBoxItem Content="AMD AMF" Tag="AMD"/><ComboBoxItem Content="Intel Quick Sync" Tag="Intel"/><ComboBoxItem Content="CPU · Compatibility" Tag="CPU"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="BITRATE" Style="{StaticResource Caption}" Margin="0,0,0,8"/><ComboBox x:Name="BitrateBox" SelectionChanged="CaptureSettingChanged"><ComboBoxItem Content="4 Mbps · Small clips" Tag="4"/><ComboBoxItem Content="8 Mbps · Balanced" Tag="8"/><ComboBoxItem Content="12 Mbps · Detailed" Tag="12"/><ComboBoxItem Content="20 Mbps · High detail" Tag="20"/></ComboBox></StackPanel>
              </Grid>
              <CheckBox x:Name="CursorToggle" Content="Include mouse cursor" Margin="0,20,0,0" Checked="CaptureSettingChanged" Unchecked="CaptureSettingChanged"/>
              <TextBlock Text="GPU capture uses native display resolution. CPU fallback is capped at 30 FPS and 1280 px width." Style="{StaticResource MutedText}" FontSize="11" Margin="0,16,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel x:Name="AudioControls">
              <TextBlock Text="Sound, your way" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <CheckBox x:Name="SystemAudioToggle" Content="System audio" Checked="CaptureSettingChanged" Unchecked="CaptureSettingChanged"/>
              <TextBlock Text="Capture your current Windows output device with native loopback audio." Style="{StaticResource MutedText}" FontSize="12" Margin="50,6,0,19"/>
              <CheckBox x:Name="MicrophoneToggle" Content="Microphone" Checked="CaptureSettingChanged" Unchecked="CaptureSettingChanged"/>
              <TextBlock Text="Mix your default microphone into the clip. Windows microphone access must be enabled." Style="{StaticResource MutedText}" FontSize="12" Margin="50,6,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
              <TextBlock Text="Shortcut &amp; storage" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <TextBlock Text="SAVE CLIP SHORTCUT" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="CaptureHotkey" ToolTip="Click, then press your new shortcut"/>
                <Button Content="Reset" Grid.Column="1" Margin="12,0,0,0" Click="ResetHotkey"/>
              </Grid>
              <TextBlock Text="Click the field, then press a shortcut with Ctrl, Alt, or Shift. It works while Rewind is in the tray." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,18"/>
              <TextBlock Text="CLIPS FOLDER" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" IsReadOnly="True" TextWrapping="NoWrap"/>
                <Button x:Name="BrowseFolderButton" Content="Choose" Grid.Column="1" Margin="12,0,0,0" Click="ChooseFolder"/>
              </Grid>
              <CheckBox x:Name="TrayToggle" Content="Keep Rewind in the tray when minimized or closed" Margin="0,22,0,0" Checked="GeneralSettingChanged" Unchecked="GeneralSettingChanged"/>
              <CheckBox x:Name="NotificationsToggle" Content="Show a notification when a clip is saved" Margin="0,17,0,0" Checked="GeneralSettingChanged" Unchecked="GeneralSettingChanged"/>
              <CheckBox x:Name="AutomaticUpdatesToggle" Content="Install GitHub release updates automatically when recording is paused" Margin="0,17,0,0" Checked="GeneralSettingChanged" Unchecked="GeneralSettingChanged"/>
            </StackPanel></Border>
            <Grid Margin="0,19,0,7"><Button Content="Open diagnostics log" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="OpenLog"/><Button Content="Quit Rewind" Style="{StaticResource QuietButton}" Foreground="#D9A9A3" HorizontalAlignment="Right" Click="QuitRewind"/></Grid>
          </StackPanel>
        </ScrollViewer>
          <ScrollViewer x:Name="DiscordPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,5,0">
            <TextBlock Text="Keep your friends in the loop." FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="A little presence for your biggest moments." Style="{StaticResource MutedText}" Margin="0,7,0,22"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Grid><TextBlock Text="Discord Rich Presence" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="DiscordToggle" HorizontalAlignment="Right" Checked="ToggleDiscord" Unchecked="ToggleDiscord" AutomationProperties.Name="Enable Discord Rich Presence"/></Grid>
              <TextBlock Text="Show your Rewind activity automatically while the Discord desktop app is open." Style="{StaticResource MutedText}" Margin="0,10,0,20"/>
              <Border Background="#111113" CornerRadius="9" Padding="16"><Grid>
                <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="DiscordStatusText" Text="Waiting for Discord" FontSize="12"/></StackPanel>
                <TextBlock Text="AUTOMATIC" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              </Grid></Border>
              <TextBlock x:Name="DiscordConnectionHint" Text="Presence connects automatically whenever the Discord desktop app is running." Style="{StaticResource MutedText}" FontSize="13" Margin="0,23,0,12"/>
                <TextBlock Text="No application ID, token, or login is needed in Rewind. You can turn presence off at any time." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,20"/>
                <Button Content="Reconnect" HorizontalAlignment="Left" Click="ReconnectDiscord" Padding="17,10"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,17,0,0"><StackPanel>
              <TextBlock Text="PRESENCE PREVIEW" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
              <StackPanel Orientation="Horizontal">
                <Border Width="76" Height="76" Background="#29292D" CornerRadius="14" Margin="0,0,18,0"><Viewbox Margin="12"><Canvas Width="96" Height="80"><Path Fill="{StaticResource Accent}" Data="{StaticResource RewindLogoGeometry}"/></Canvas></Viewbox></Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Playing Rewind" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="PresenceDetails" Text="Ready for the next highlight" Margin="0,7,0,0" FontSize="13"/><TextBlock x:Name="PresenceState" Text="Browsing the clip library" Foreground="{StaticResource Muted}" Margin="0,5,0,0" FontSize="12"/></StackPanel>
              </StackPanel>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
          <Border x:Name="Toast" Visibility="Collapsed" Background="#2B2B30" BorderBrush="#55555D" BorderThickness="1" CornerRadius="8" Padding="18,13" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="12,0,23,10" Panel.ZIndex="10">
            <Grid><TextBlock x:Name="ToastText" TextWrapping="Wrap" Margin="0,0,27,0" FontSize="13"/><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" FontSize="10" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Top" Click="DismissToast"/></Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
